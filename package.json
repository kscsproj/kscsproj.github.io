{
  "name": "view-page",
  "version": "1.0.0",
  "description": "国土数値情報などのオープンデータを可視化する個人プロジェクトのポータル(ホームページ)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:busroute": "node scripts/sync-busroute.mjs",
    "build:ryoseikoku": "node scripts/sync-ryoseikoku.mjs",
    "build:historical-region": "node scripts/sync-historical-region.mjs",
    "build": "pnpm run build:busroute && pnpm run build:ryoseikoku && pnpm run build:historical-region && vite build",
    "preview": "vite preview"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.17.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "vite": "^8.2.2"
  }
}
